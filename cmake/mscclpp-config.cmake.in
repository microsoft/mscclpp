@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@MSCCLPP_USE_CUDA@)
    find_dependency(CUDAToolkit)
elseif(@MSCCLPP_USE_ROCM@)
    find_dependency(hip)
endif()
set(_mscclpp_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(NUMA)
if(@MSCCLPP_USE_IB@)
    find_dependency(IBVerbs)
endif()
if(@MSCCLPP_USE_GDRCOPY@)
    find_dependency(GDRCopy)
endif()
set(CMAKE_MODULE_PATH "${_mscclpp_module_path}")
unset(_mscclpp_module_path)

include("${CMAKE_CURRENT_LIST_DIR}/mscclppTargets.cmake")
set_property(TARGET mscclpp::mscclpp_static APPEND PROPERTY INTERFACE_LINK_LIBRARIES
    Threads::Threads ${CMAKE_DL_LIBS} ${NUMA_LIBRARIES})
if(@MSCCLPP_USE_CUDA@)
    set_property(TARGET mscclpp::mscclpp APPEND PROPERTY INTERFACE_LINK_LIBRARIES CUDA::cudart CUDA::cuda_driver)
    set_property(TARGET mscclpp::mscclpp_static APPEND PROPERTY INTERFACE_LINK_LIBRARIES
        CUDA::cudart CUDA::cuda_driver CUDA::nvml)
elseif(@MSCCLPP_USE_ROCM@)
    set_property(TARGET mscclpp::mscclpp APPEND PROPERTY INTERFACE_LINK_LIBRARIES hip::device)
    set_property(TARGET mscclpp::mscclpp_static APPEND PROPERTY INTERFACE_LINK_LIBRARIES hip::device)
endif()
if(@MSCCLPP_USE_IB@)
    set_property(TARGET mscclpp::mscclpp_static APPEND PROPERTY INTERFACE_LINK_LIBRARIES ${IBVERBS_LIBRARIES})
endif()
if(@MSCCLPP_USE_GDRCOPY@)
    set_property(TARGET mscclpp::mscclpp_static APPEND PROPERTY INTERFACE_LINK_LIBRARIES ${GDRCOPY_LIBRARIES})
endif()
check_required_components(mscclpp)